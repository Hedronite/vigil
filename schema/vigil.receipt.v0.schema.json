{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hedronite/vigil/schema/vigil.receipt.v0.schema.json",
  "title": "vigil.receipt/v0",
  "description": "Acknowledgement that testimony was accepted on POST. HTTP 202.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "source",
    "generated_at",
    "received_at"
  ],
  "properties": {
    "apiVersion": {
      "const": "vigil.receipt/v0"
    },
    "source": {
      "type": "string",
      "enum": [
        "simplex",
        "augur"
      ]
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "received_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hedronite/vigil/schema/vigil.query.v0.schema.json",
  "title": "vigil.query/v0",
  "description": "One named query's answer. Sample values stay strings: Prometheus reports them that way and a float would round them. Only the host and the job are carried over from the returned labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "backend", "vantage", "name", "evaluated_at", "series"],
  "properties": {
    "apiVersion": { "const": "vigil.query/v0" },
    "backend": { "$ref": "#/$defs/token" },
    "vantage": { "$ref": "#/$defs/slug" },
    "name": { "$ref": "#/$defs/name" },
    "host": {
      "description": "Present when the query was run for one host.",
      "$ref": "#/$defs/slug"
    },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "value"],
        "properties": {
          "host": { "$ref": "#/$defs/slug" },
          "job": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "value": {
            "description": "The sample as Prometheus reports it, so NaN and +Inf survive.",
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}

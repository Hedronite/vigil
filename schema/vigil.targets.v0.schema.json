{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hedronite/vigil/schema/vigil.targets.v0.schema.json",
  "title": "vigil.targets/v0",
  "description": "The scrape targets a backend reports, reduced to what may be published: the host slug, the job, the health and when it was last scraped. Addresses, last errors and discovered labels never reach this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "backend", "vantage", "generated_at", "targets"],
  "properties": {
    "apiVersion": { "const": "vigil.targets/v0" },
    "backend": { "$ref": "#/$defs/token" },
    "vantage": { "$ref": "#/$defs/slug" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "job", "health", "last_scrape"],
        "properties": {
          "host": { "$ref": "#/$defs/slug" },
          "job": {
            "description": "The job label when it has a publishable shape, redacted otherwise.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "health": { "type": "string", "enum": ["up", "down", "unknown"] },
          "last_scrape": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}

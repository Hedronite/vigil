{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hedronite/vigil/schema/vigil.health.v0.schema.json",
  "title": "vigil.health/v0",
  "description": "The health of one named backend, checked live. A login page or any other body that is not the backend's own health answer is not health.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "backend", "state", "checked_at"],
  "properties": {
    "apiVersion": { "const": "vigil.health/v0" },
    "backend": { "$ref": "#/$defs/token" },
    "state": {
      "description": "Stale never applies: the check is live, so it is either answered or not.",
      "type": "string",
      "enum": ["ok", "unavailable"]
    },
    "detail_code": {
      "description": "Why the backend is not healthy, or null when it is.",
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "checked_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}

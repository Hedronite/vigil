{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hedronite/vigil/schema/vigil.overlay.v0.schema.json",
  "title": "vigil.overlay/v0",
  "description": "Off-repo overlay (YAML): the only place a backend address exists. Keys are the ids declared in vigil.config/v0; an address is never accepted from argv, a route or a query.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "backends"
  ],
  "properties": {
    "apiVersion": {
      "const": "vigil.overlay/v0"
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "address"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9\\-]{0,31}$"
          },
          "address": {
            "description": "Scheme, host, optional port and optional path segments. No userinfo, no query, no fragment and no . or .. segments; redirects are never followed.",
            "type": "string",
            "pattern": "^https?://[A-Za-z0-9]([A-Za-z0-9.\\-]{0,252})(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?(/[A-Za-z0-9._~%\\-]*)*$",
            "allOf": [
              {
                "not": {
                  "pattern": "/\\.\\.?(/|$)"
                }
              }
            ]
          }
        }
      }
    },
    "hosts": {
      "description": "Maps the instance labels a backend reports onto one public slug. Without a mapping an instance prints as unmapped.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "instances"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9\\-]{0,31}$"
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:\\[\\]-]{1,255}$"
            }
          }
        }
      }
    }
  }
}
